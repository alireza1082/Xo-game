<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_back</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_content</item>
        <!-- core-splashscreen's supported equivalent of windowSplashScreenIconSize. -->
        <item name="splashScreenIconSize">108dp</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
