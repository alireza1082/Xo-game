<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_difficulty"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Difficulty Radios -->
    <RadioGroup
        android:id="@+id/rg_difficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rb_easy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/difficulty_easy"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary" />

        <RadioButton
            android:id="@+id/rb_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/difficulty_medium"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary" />

        <RadioButton
            android:id="@+id/rb_impossible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/difficulty_impossible"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#E2E8F0" />

    <!-- Symbol Selection Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_symbol"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Symbol Radios -->
    <RadioGroup
        android:id="@+id/rg_symbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rb_symbol_x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/symbol_x_desc"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary" />

        <RadioButton
            android:id="@+id/rb_symbol_o"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/symbol_o_desc"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary" />
    </RadioGroup>

</LinearLayout>
