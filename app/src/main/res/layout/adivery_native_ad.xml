<?xml version="1.0" encoding="utf-8"?>
<!--
  Native ad template passed to com.adivery.sdk.AdiveryNativeAdView.setNativeAdLayout().

  Adivery resolves these views by id (com.adivery.sdk.R.id.*), so the ids must match exactly:
  adivery_wrapper, adivery_headline, adivery_description, adivery_advertiser,
  adivery_call_to_action, adivery_icon and adivery_image. The last one must be an
  AdiveryNativeAdMediaView, which is what the SDK casts the resolved view to.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adivery_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/adivery_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF212121"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adivery_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FF616161"
        android:textSize="13sp" />

    <com.adivery.sdk.AdiveryNativeAdMediaView
        android:id="@+id/adivery_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/adivery_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/adivery_advertiser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF757575"
            android:textSize="12sp" />

        <Button
            android:id="@+id/adivery_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
